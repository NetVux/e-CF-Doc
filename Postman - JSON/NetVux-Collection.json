                    }
                ],
                "url": {
                    "raw": "https://sandbox.netvux.com/v2/api/ecf",
                    "protocol": "https",
                    "host": [
                        "sandbox",
                        "netvux",
                        "com"
                    ],
                    "path": [
                        "v2",
                        "api",
                        "ecf"
                    ]
                },
                "body": {
                    "mode": "formdata",
